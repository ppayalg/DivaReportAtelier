# Copy to .env and edit. Nothing here is required to try the project offline.

# mock (default, offline, deterministic) or anthropic
DIVA_LLM_PROVIDER=mock

# Needed only when DIVA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5
DIVA_MODEL=

# Protects every /api route except /api/health. Strongly recommended off localhost.
DIVA_API_TOKEN=

# Where configurations, reports and feedback are stored (default: ./var)
DIVA_DATA_DIR=var
# Where *.jsonl knowledge files live (default: ./data/knowledge)
DIVA_KNOWLEDGE_DIR=data/knowledge
# Copied into DIVA_DATA_DIR on first run when it has no configurations yet
DIVA_SEED_CONFIGS=configs
# Log every HTTP request (set to any value)
DIVA_ACCESS_LOG=
